# Copy to backend/.env for local development. Never commit the real file.
# Generate secrets:  uv run python -m app.cli gen-secrets

ENVIRONMENT=development            # development | test | production
DATABASE_URL=postgresql+psycopg://bkmk@localhost:54329/bkmk   # ./scripts/dev-db.sh start

# The browser-facing origin. In production: https://<your-app>.vercel.app
FRONTEND_URL=http://localhost:5173
# Only when the SPA is served from a different origin (not needed with the Vite proxy or same-origin deploys)
ALLOWED_ORIGINS=

# Live X sync reads bookmarks through X's PAID pay-per-use API (sign-in alone is a billed read).
# Off by default: the app then makes no X API calls and users import files instead.
LIVE_SYNC_ENABLED=false

# X OAuth 2.0 — only used when LIVE_SYNC_ENABLED=true.
# "fixture" uses recorded responses, no credentials needed (refused in production)
X_API_MODE=fixture
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:5173/api/auth/x/callback

# Secrets (required; no defaults)
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Cost and abuse controls (X bills per post/user read: see docs/cost-model.md)
X_DAILY_BUDGET_USD=5.00            # global cap per UTC day across all users; 0 disables live scans
ALLOWED_X_USERNAMES=               # optional private-beta allowlist, comma-separated; empty = anyone
SCAN_MAX_BOOKMARKS=30              # starter scan: newest 30 only (each post read is billed)
SCAN_PAGE_SIZE=100
SCAN_REFRESH_PROBE_SIZE=1          # refresh reads the newest bookmark first and stops if it's known
SCAN_REFRESH_PAGE_SIZE=10
SCAN_COOLDOWN_SECONDS=3600
X_EXPAND_AUTHORS=false             # author profiles are a separate $0.010 read each; unused by scoring
AUTH_RATE_LIMIT_PER_MINUTE=20

# Retention: accounts with no sign-in or scan for this many days are revoked and deleted (0 = keep)
DATA_RETENTION_DAYS=90
