# Copy to backend/.env for local development. Never commit the real file.
# Generate secrets:  uv run python -m app.cli gen-secrets

ENVIRONMENT=development            # development | test | production
DATABASE_URL=postgresql+psycopg://bkmk@localhost:54329/bkmk   # ./scripts/dev-db.sh start

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Only when the SPA is served from a different origin (not needed with the Vite proxy or same-origin deploys)
ALLOWED_ORIGINS=

# X OAuth 2.0 — "fixture" uses recorded responses, no credentials needed (refused in production)
X_API_MODE=fixture
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:5173/api/auth/x/callback

# Secrets (required; no defaults)
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Cost and abuse controls
SCAN_MAX_BOOKMARKS=800
SCAN_PAGE_SIZE=100
SCAN_REFRESH_PAGE_SIZE=25
SCAN_COOLDOWN_SECONDS=300
X_EXPAND_AUTHORS=true
AUTH_RATE_LIMIT_PER_MINUTE=20
