# Public build-time values only. Anything prefixed VITE_ ends up in the browser bundle.
# Public URL used in share captions and on share cards (defaults to the current origin).
VITE_PUBLIC_URL=
# API origin. Leave empty for same-origin deploys and the Vite dev proxy.
VITE_API_BASE=
# Optional link for "Request access updates" while X import is off: a form, newsletter or mailto: you control.
# Only https: and mailto: links are shown; leave empty to hide the button.
VITE_ACCESS_UPDATES_URL=
